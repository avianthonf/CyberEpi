{
  "expo": {
    "name": "CyberEpi Patient",
    "slug": "cyberepi-patient",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "cyberepi-patient",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "health.cyberepi.patient",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan medication labels for identification.",
        "NSPhotoLibraryUsageDescription": "This app needs access to photo library to select images for medication scanning.",
        "NSHealthShareUsageDescription": "This app uses health data to provide personalized risk assessments.",
        "NSHealthUpdateUsageDescription": "This app may update certain health metrics with your permission.",
        "NSMotionUsageDescription": "This app uses motion data to improve activity tracking."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "health.cyberepi.patient",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.WRITE_STEPS",
        "android.permission.health.WRITE_HEART_RATE",
        "android.permission.health.WRITE_OXYGEN_SATURATION",
        "android.permission.health.WRITE_SLEEP",
        "android.permission.health.WRITE_HEART_RATE_VARIABILITY",
        "android.permission.health.WRITE_RESTING_HEART_RATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CyberEpi to access your camera to scan medications."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/notification.wav"
          ]
        }
      ],
      [
        "react-native-health",
        {
          "permissions": {
            "healthShare": [
              "HKQuantityTypeIdentifierHeartRate",
              "HKQuantityTypeIdentifierHeartRateVariabilitySDNN",
              "HKQuantityTypeIdentifierOxygenSaturation",
              "HKCategoryTypeIdentifierSleepAnalysis",
              "HKQuantityTypeIdentifierStepCount",
              "HKQuantityTypeIdentifierRestingHeartRate"
            ],
            "healthUpdate": []
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-project-id-here"
      }
    }
  }
}
