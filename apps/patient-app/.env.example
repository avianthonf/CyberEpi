# API Configuration
EXPO_PUBLIC_API_URL=https://api.cyberepi.health/api/v1

# OAuth2 / Keycloak Configuration
EXPO_PUBLIC_KEYCLOAK_URL=https://auth.cyberepi.health
EXPO_PUBLIC_KEYCLOAK_REALM=cyberepi
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=patient-app

# Push Notification Service (optional for development)
EXPO_PUBLIC_PROJECT_ID=your-expo-project-id

# Feature Flags
EXPO_PUBLIC_ENABLE_WEARABLE=true
EXPO_PUBLIC_ENABLE_OFFLINE=true
EXPO_PUBLIC_ENABLE_PUSH=true
