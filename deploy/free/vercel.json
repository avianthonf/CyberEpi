{
  "version": 2,
  "name": "cyberepi",
  "builds": [
    {
      "src": "services/user-service/Dockerfile",
      "use": "@vercel/docker"
    },
    {
      "src": "services/symptom-service/Dockerfile",
      "use": "@vercel/docker"
    },
    {
      "src": "services/prescription-service/Dockerfile",
      "use": "@vercel/docker"
    },
    {
      "src": "services/notification-service/Dockerfile",
      "use": "@vercel/docker"
    },
    {
      "src": "services/epi-engine/Dockerfile",
      "use": "@vercel/docker"
    },
    {
      "src": "services/privacy-service/Dockerfile",
      "use": "@vercel/docker"
    }
  ],
  "routes": [
    {
      "src": "/api/v1/auth(.*)",
      "dest": "https://user-service.cyberepi.vercel.app$1"
    },
    {
      "src": "/api/v1/patients(.*)",
      "dest": "https://user-service.cyberepi.vercel.app$1"
    },
    {
      "src": "/api/v1/symptoms(.*)",
      "dest": "https://symptom-service.cyberepi.vercel.app$1"
    },
    {
      "src": "/api/v1/prescriptions(.*)",
      "dest": "https://prescription-service.cyberepi.vercel.app$1"
    },
    {
      "src": "/api/v1/medications(.*)",
      "dest": "https://prescription-service.cyberepi.vercel.app$1"
    },
    {
      "src": "/api/v1/notifications(.*)",
      "dest": "https://notification-service.cyberepi.vercel.app$1"
    },
    {
      "src": "/api/v1/physicians(.*)",
      "dest": "https://notification-service.cyberepi.vercel.app$1"
    },
    {
      "src": "/api/v1/regions(.*)",
      "dest": "https://epi-engine.cyberepi.vercel.app$1"
    },
    {
      "src": "/api/v1/map(.*)",
      "dest": "https://epi-engine.cyberepi.vercel.app$1"
    },
    {
      "src": "/api/v1/control(.*)",
      "dest": "https://epi-engine.cyberepi.vercel.app$1"
    },
    {
      "src": "/api/v1/simulate(.*)",
      "dest": "https://epi-engine.cyberepi.vercel.app$1"
    }
  ],
  "env": {
    "DATABASE_URL": "@database_url",
    "REDIS_URL": "@redis_url",
    "KAFKA_BOOTSTRAP_SERVERS": "@kafka_servers"
  }
}
