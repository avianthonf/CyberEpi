# Database
POSTGRES_PASSWORD=devpassword
DATABASE_URL=postgresql+asyncpg://cyberepi:devpassword@localhost:5432/cyberepi

# Services
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
LOG_LEVEL=INFO

# Authentication
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=cyberepi
KEYCLOAK_ADMIN_PASSWORD=admin

# External APIs
OPENFDA_API_URL=https://api.fda.gov/drug/label.json
RXNORM_API_URL=https://rxnav.nlm.nih.gov/REST

# Push notifications (notification-service). Leave empty in dev:
# sends are attempted and logged as failures, endpoints still return 200
# with platforms_sent=[] so no real push is claimed.
FIREBASE_CREDENTIALS_PATH=
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.cyberepi.patient

# Service ports
SERVICE_PORT_USER=8001
SERVICE_PORT_SYMPTOM=8002
SERVICE_PORT_PRESCRIPTION=8003
SERVICE_PORT_NOTIFICATION=8004
SERVICE_PORT_EPI=8005
SERVICE_PORT_PRIVACY=8006
