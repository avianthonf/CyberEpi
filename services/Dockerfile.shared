# Build a service image that has the venv + libs + shared code baked in.
# Each per-service build simply overlays the service source.
#
# Usage from a service directory:
#   FROM cyberepi-runtime:latest
#   COPY . /app/svc
#   WORKDIR /app/svc
#   CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8001"]
#
# The runtime image copies the host venv in during build. To refresh after
# a `pip install` on the host: `make rebuild-runtime`.

FROM docker.io/library/python:3.14-slim

# venv layout (built on host, copied in)
COPY .venv /app/.venv
COPY libs /app/libs

ENV PATH="/app/.venv/bin:/usr/local/bin:/usr/bin:/bin" \
    PYTHONUNBUFFERED=1

WORKDIR /app/svc
