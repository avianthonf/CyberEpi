{
    "annotations": {
        "list": []
    },
    "editable": true,
    "panels": [
        {
            "title": "Patients by Risk Tier",
            "type": "piechart",
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "expr": "cyberepi_patients_by_tier",
                    "legendFormat": "{{ tier }}",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "Deterioration Alerts (24h)",
            "type": "stat",
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 8,
                "y": 0
            },
            "targets": [
                {
                    "expr": "sum(increase(cyberepi_deterioration_alerts_total[24h]))",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 10
                            },
                            {
                                "color": "red",
                                "value": 50
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "Symptom Reports (rate/min)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 16,
                "y": 0
            },
            "targets": [
                {
                    "expr": "sum(rate(cyberepi_symptom_reports_total[5m])) * 60",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "Risk Score Distribution",
            "type": "histogram",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 8
            },
            "targets": [
                {
                    "expr": "cyberepi_risk_score_bucket",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "Active Prescriptions",
            "type": "stat",
            "gridPos": {
                "h": 8,
                "w": 6,
                "x": 12,
                "y": 8
            },
            "targets": [
                {
                    "expr": "cyberepi_active_prescriptions_total",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "Drug Interactions Detected (24h)",
            "type": "stat",
            "gridPos": {
                "h": 8,
                "w": 6,
                "x": 18,
                "y": 8
            },
            "targets": [
                {
                    "expr": "sum(increase(cyberepi_drug_interactions_total[24h]))",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 1
                            }
                        ]
                    }
                }
            }
        }
    ],
    "refresh": "30s",
    "schemaVersion": 39,
    "tags": [
        "cyberepi",
        "clinical"
    ],
    "time": {
        "from": "now-24h",
        "to": "now"
    },
    "title": "CyberEpi - Clinical",
    "uid": "cyberepi-clinical"
}