{
    "annotations": {
        "list": []
    },
    "editable": true,
    "panels": [
        {
            "title": "Rt by Region",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "expr": "cyberepi_rt_current",
                    "legendFormat": "{{ region_id }}",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "Filter State (S/E/I/R) Over Time",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "targets": [
                {
                    "expr": "cyberepi_compartment_S",
                    "legendFormat": "S - {{ region_id }}",
                    "refId": "A"
                },
                {
                    "expr": "cyberepi_compartment_I",
                    "legendFormat": "I - {{ region_id }}",
                    "refId": "B"
                },
                {
                    "expr": "cyberepi_compartment_R",
                    "legendFormat": "R - {{ region_id }}",
                    "refId": "C"
                }
            ]
        },
        {
            "title": "ODE Solve Time (ms)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 8
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.99, rate(cyberepi_ode_solve_seconds_bucket[5m])) * 1000",
                    "legendFormat": "p99",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ms"
                }
            }
        },
        {
            "title": "Daily Confirmed Cases",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 8
            },
            "targets": [
                {
                    "expr": "cyberepi_confirmed_cases_daily",
                    "legendFormat": "{{ region_id }}",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "Hotspot Alerts (24h)",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 12,
                "x": 0,
                "y": 16
            },
            "targets": [
                {
                    "expr": "sum(increase(cyberepi_hotspot_alerts_total[24h]))",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "Hospital Capacity Utilization",
            "type": "gauge",
            "gridPos": {
                "h": 4,
                "w": 12,
                "x": 12,
                "y": 16
            },
            "targets": [
                {
                    "expr": "cyberepi_hospital_current_h / cyberepi_hospital_capacity_h * 100",
                    "legendFormat": "{{ region_id }}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "max": 100
                }
            }
        }
    ],
    "refresh": "30s",
    "schemaVersion": 39,
    "tags": [
        "cyberepi",
        "epidemiology"
    ],
    "time": {
        "from": "now-24h",
        "to": "now"
    },
    "title": "CyberEpi - Epidemiology",
    "uid": "cyberepi-epidemiology"
}