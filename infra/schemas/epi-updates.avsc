{
  "type": "record",
  "name": "EpiUpdate",
  "namespace": "com.cyberepi.events",
  "doc": "Event emitted when epidemiological state changes: Rt updates, state transitions, hotspot alerts, or control recommendations.",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "Unique event identifier (UUID v4)"
    },
    {
      "name": "region_id",
      "type": "string",
      "doc": "Geographic region identifier"
    },
    {
      "name": "patch_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "Optional sub-region patch identifier"
    },
    {
      "name": "timestamp_ms",
      "type": "long",
      "doc": "Event timestamp in epoch milliseconds"
    },
    {
      "name": "update_type",
      "type": {
        "type": "enum",
        "name": "UpdateType",
        "symbols": ["RT_UPDATE", "STATE_UPDATE", "HOTSPOT_ALERT", "CONTROL_RECOMMENDATION"]
      },
      "doc": "Category of epidemiological update"
    },
    {
      "name": "Rt",
      "type": ["null", "float"],
      "default": null,
      "doc": "Effective reproduction number (if applicable)"
    },
    {
      "name": "payload",
      "type": "string",
      "doc": "JSON-encoded update payload"
    }
  ]
}
